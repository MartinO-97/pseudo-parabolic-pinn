{
  	"name": "PyTorch PINN for Pseudo Parabolic Equations",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "..",
		"options": ["-t=pseudo-parabolic-pinn"]
	},
	"remoteUser": "teli",
	"runArgs": ["--gpus", "all"],
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/teli/workspace,type=bind,consistency=cached",
  	"workspaceFolder": "/home/teli/workspace",	
	
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python3"
			}

		}
	}
}
